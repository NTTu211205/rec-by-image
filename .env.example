# Copy to .env and adjust as needed: cp .env.example .env
POSTGRES_DB=mwgshop
POSTGRES_USER=mwg
POSTGRES_PASSWORD=mwg_secret
# Host port mapped to the container's 5432 (5432 is often taken by local Postgres)
POSTGRES_PORT=55432
ADMINER_PORT=58080
TZ=Asia/Ho_Chi_Minh

# Remove Background API
REMOVE_BG_BASE_URL=https://trio-tycoon-backpedal.ngrok-free.dev
