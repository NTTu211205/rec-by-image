# Copy to .env and adjust as needed: cp .env.example .env
POSTGRES_DB=mwgshop
POSTGRES_USER=mwg
POSTGRES_PASSWORD=mwg_secret
# Host port mapped to the container's 5432 (5432 is often taken by local Postgres)
POSTGRES_PORT=55432
ADMINER_PORT=58080
TZ=Asia/Ho_Chi_Minh

# Remove Background API
REMOVE_BG_BASE_URL=https://ai.itmwg.vn/api

# FLUX.2 Klein 4B Generative Render Refiner
FLUX_RENDER_ENABLED=false
FLUX_MODEL_ID=black-forest-labs/FLUX.2-klein-4B
FLUX_DEVICE=auto
FLUX_INFERENCE_STEPS=4
FLUX_DENOISING_STRENGTH=0.38
